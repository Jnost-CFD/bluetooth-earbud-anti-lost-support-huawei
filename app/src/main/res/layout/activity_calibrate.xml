<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1116"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/cal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_calibrate"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cal_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingExtra="5dp"
        android:textColor="#FFB6BFCC"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/cal_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0" />

    <Button
        android:id="@+id/cal_action"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#FF2E7CF6"
        android:text="@string/cal_action"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
</LinearLayout>
