<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF0E1116">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle"
            android:textColor="#FF8A94A6"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FF161B22"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_device"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_addr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF8A94A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_device_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF6E7686"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#FF8A94A6"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_pick"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#FF2B3546"
            android:text="@string/pick_device"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/btn_find"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FF2E7CF6"
            android:text="@string/find_device"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#FF161B22"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_alarm"
                android:textColor="#FFB6BFCC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/confirm_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FF1E2A3B"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_question"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_in_case"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF2E7CF6"
                        android:text="@string/btn_in_case"
                        android:textColor="#FFFFFFFF" />

                    <Button
                        android:id="@+id/btn_not_in_case"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF2B3546"
                        android:text="@string/btn_not_in_case"
                        android:textColor="#FFFFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clear_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FF1E2A3B"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_question"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_clear_hist"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF2E7CF6"
                        android:text="@string/btn_clear"
                        android:textColor="#FFFFFFFF" />

                    <Button
                        android:id="@+id/btn_keep_hist"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF2B3546"
                        android:text="@string/btn_keep"
                        android:textColor="#FFFFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <Switch
                android:id="@+id/sw_monitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/alarm_master"
                android:textColor="#FFFFFFFF" />

            <Switch
                android:id="@+id/sw_presence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/alarm_presence"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_beacon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/beacon_none"
                android:textColor="#FF6E7686"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_probe"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF2B3546"
                android:text="@string/probe_open"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_calibrate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#FF2B3546"
                android:text="@string/calibrate"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_history"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#FF2B3546"
                android:text="@string/history_open"
                android:textColor="#FFFFFFFF" />

            <Switch
                android:id="@+id/sw_repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/alarm_repeat"
                android:textColor="#FFD6DCE5" />

            <Switch
                android:id="@+id/sw_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/alarm_sound"
                android:textColor="#FFD6DCE5" />

            <Switch
                android:id="@+id/sw_vibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/alarm_vibrate"
                android:textColor="#FFD6DCE5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/alarm_distance"
                android:textColor="#FFD6DCE5"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <RadioButton
                    android:id="@+id/rb_lv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lv1"
                    android:textColor="#FFD6DCE5" />

                <RadioButton
                    android:id="@+id/rb_lv2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lv2"
                    android:textColor="#FFD6DCE5" />

                <RadioButton
                    android:id="@+id/rb_lv3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lv3"
                    android:textColor="#FFD6DCE5" />

                <RadioButton
                    android:id="@+id/rb_lv4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lv4"
                    android:textColor="#FFD6DCE5" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/delay_default"
                android:textColor="#FFD6DCE5"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sb_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/hint_offline"
            android:textColor="#FF6E7686"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
